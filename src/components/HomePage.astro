---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero from '../assets/hero-tech-3d-v1.jpg';
import holo from '../assets/illu-data-orb-3d-v1.jpg';
import field from '../assets/illu-field-3d-v1.jpg';
import training from '../assets/illu-training-3d-v1.jpg';
import systems from '../assets/illu-systems-3d-v1.jpg';
import solBi from '../assets/sol-bi-3d-v1.jpg';
import solErp from '../assets/sol-erp-3d-v1.jpg';
import solMobile from '../assets/sol-mobile-3d-v1.jpg';
import solSales from '../assets/sol-sales-3d-v1.jpg';
import solLearn from '../assets/sol-learn-3d-v1.jpg';
import solHw from '../assets/sol-hw-3d-v1.jpg';
import powerbi from '../assets/logos/powerbi.svg';
import odoo from '../assets/logos/odoo.svg';
import react from '../assets/logos/react.svg';
import typescript from '../assets/logos/typescript.svg';
import python from '../assets/logos/python.svg';
import docker from '../assets/logos/docker.svg';
import microsoft from '../assets/logos/microsoft.svg';
import azure from '../assets/logos/azure.svg';
import dell from '../assets/logos/dell.svg';
import hp from '../assets/logos/hp.svg';
import iiyama from '../assets/logos/iiyama.svg';
import crm from '../assets/logos/crm.svg';
import lms from '../assets/logos/lms.svg';
import mysql from '../assets/logos/mysql.svg';
import postgresql from '../assets/logos/postgresql.svg';
import nodedotjs from '../assets/logos/nodedotjs.svg';
import HomeExperience from './HomeExperience';
import { LMS_URL, contactPath, getCopy, homePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);
const contact = contactPath(lang);
const home = homePath(lang);

async function asset(src: ImageMetadata, widths: number[]) {
  const image = await getImage({ src, widths, format: 'webp', quality: 80 });
  return {
    src: image.src,
    srcSet: image.srcSet.attribute,
    width: Number(image.attributes.width),
    height: Number(image.attributes.height),
  };
}

const images = {
  hero: await asset(hero, [640, 960, 1280, 1600, 1920]),
  holo: await asset(holo, [480, 768, 1024]),
  systems: await asset(systems, [480, 768, 1024, 1280]),
  field: await asset(field, [480, 768, 1024, 1280]),
  training: await asset(training, [480, 768, 1024, 1280]),
  solutions: await Promise.all(
    [solBi, solErp, solMobile, solSales, solLearn, solHw].map((src) => asset(src, [360, 540, 720])),
  ),
};

const asUrl = (mod: string | { src: string }) => (typeof mod === 'string' ? mod : mod.src);

const logos = [
  { src: asUrl(powerbi), label: 'Power BI' },
  { src: asUrl(odoo), label: 'Odoo' },
  { src: asUrl(microsoft), label: 'Microsoft' },
  { src: asUrl(azure), label: 'Azure' },
  { src: asUrl(crm), label: 'CRM' },
  { src: asUrl(react), label: 'React' },
  { src: asUrl(typescript), label: 'TypeScript' },
  { src: asUrl(python), label: 'Python' },
  { src: asUrl(nodedotjs), label: 'Node.js' },
  { src: asUrl(docker), label: 'Docker' },
  { src: asUrl(postgresql), label: 'PostgreSQL' },
  { src: asUrl(mysql), label: 'MySQL' },
  { src: asUrl(dell), label: 'Dell' },
  { src: asUrl(hp), label: 'HP' },
  { src: asUrl(iiyama), label: 'IIYAMA' },
  { src: asUrl(lms), label: 'LMS' },
];
---

<HomeExperience
  client:load
  copy={t}
  contact={contact}
  home={home}
  lms={LMS_URL}
  images={images}
  logos={logos}
/>
