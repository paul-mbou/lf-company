---
import ContactForm from './ContactForm';
import MeshConstellation from './motion/MeshConstellation';
import {
  EMAIL,
  LMS_URL,
  PHONE,
  PHONE_LABEL,
  PLACE,
  getCopy,
  type Lang,
} from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);
const poles = t.poles.items.map((item) => ({ id: item.id, title: item.title, short: item.short }));
---

<div class="contact-stage">
  <div class="contact-mesh-wrap" aria-hidden="true">
    <MeshConstellation client:load className="contact-mesh" density={48} interactive shooting tone="light" />
  </div>
  <div class="contact-atmosphere" aria-hidden="true"></div>

  <header class="contact-hero wrap">
    <p class="contact-kicker mono">
      <span class="contact-pulse" aria-hidden="true"></span>
      NOW · CONTACT · {t.hero.place}
    </p>
    <h1 class="display contact-title">{t.contact.title}</h1>
    <p class="lede contact-lede">{t.contact.lede}</p>
  </header>

  <div class="contact-layout wrap">
    <aside class="contact-rail" aria-label={t.contact.title}>
      <p class="contact-rail-index mono">01 · SIGNAL</p>
      <ul class="contact-coords">
        <li>
          <a class="contact-coord cut" href={`tel:${PHONE}`}>
            <span class="mono">{t.contact.phone}</span>
            <strong>{PHONE_LABEL}</strong>
          </a>
        </li>
        <li>
          <a class="contact-coord cut" href={`mailto:${EMAIL}`}>
            <span class="mono">{t.contact.email}</span>
            <strong>{EMAIL}</strong>
          </a>
        </li>
        <li>
          <div class="contact-coord cut">
            <span class="mono">{t.contact.place}</span>
            <strong>{PLACE}</strong>
          </div>
        </li>
        <li>
          <a class="contact-coord cut" href={LMS_URL} target="_blank" rel="noopener noreferrer">
            <span class="mono">{t.contact.learning}</span>
            <strong>
              {t.nav.learning}
              <span class="sr-only"> ({t.nav.learningNew})</span>
            </strong>
          </a>
        </li>
      </ul>
      <p class="contact-rail-note mono">LF · DATA · FIELD</p>
    </aside>

    <section class="contact-compose" aria-labelledby="contact-compose-title">
      <div class="contact-compose-head">
        <p class="mono">02 · MESSAGE</p>
        <h2 id="contact-compose-title" class="contact-compose-title">{t.form.submit}</h2>
      </div>
      <ContactForm client:load form={t.form} poles={poles} />
    </section>
  </div>
</div>
